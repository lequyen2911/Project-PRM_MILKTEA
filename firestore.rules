rules_version = '2';

// Dán nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email == 'admin.tiemtranho@gmail.com';
    }

    function isSeller() {
      return isAdminEmail()
        || (signedIn()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller');
    }

    // Thực đơn: ai cũng xem được, chỉ Seller được thêm / sửa / xóa
    match /products/{productId} {
      allow read: if true;
      allow write: if isSeller();
    }

    match /toppings/{toppingId} {
      allow read: if true;
      allow write: if isSeller();
    }

    // Hồ sơ người dùng: chỉ chính chủ (hoặc Seller) xem được.
    // Khách tự sửa phone / address / name, nhưng không được tự đổi role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSeller());
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'customer'
            || (request.resource.data.role == 'seller' && isAdminEmail()));
      allow update: if isSeller()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']));
      allow delete: if isSeller();
    }

    // Cài đặt quán (vị trí, bán kính giao): ai đăng nhập cũng đọc được để tính phí ship, chỉ Seller sửa
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isSeller();
    }

    // Đơn hàng: khách tạo đơn của chính mình (trạng thái Pending) và chỉ xem đơn của mình.
    // Khách chỉ được hủy (Pending → Cancelled) khi quán chưa xác nhận.
    // Seller đổi trạng thái theo lib/utils/order_policy.dart (giờ server, không tin giờ máy):
    //   Pending   → Preparing  khi đơn đặt chưa quá 30 phút
    //   Pending   → Cancelled  (kèm lý do)
    //   Preparing → Completed
    //   Preparing → Cancelled  khi đã nhận đơn quá 2 giờ (quá hạn)
    // Đơn Completed / Cancelled khóa hẳn; không ai được xóa đơn.
    match /orders/{orderId} {
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function movesTo(from, to) {
        return resource.data.status == from && request.resource.data.status == to;
      }

      function pendingOverdue() {
        return request.time > resource.data.createdAt + duration.value(30, 'm');
      }

      function preparingOverdue() {
        return request.time > resource.data.get('acceptedAt', resource.data.createdAt) + duration.value(2, 'h');
      }

      function sellerCancelFields() {
        return changedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy', 'cancelReason'])
          && request.resource.data.cancelledBy == 'seller'
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() <= 100;
      }

      function sellerCanUpdate() {
        return isSeller() && (
          (movesTo('Pending', 'Preparing') && !pendingOverdue()
            && changedKeys().hasOnly(['status', 'updatedAt', 'acceptedAt'])
            && request.resource.data.acceptedAt == request.time)
          || (movesTo('Pending', 'Cancelled') && sellerCancelFields())
          || (movesTo('Preparing', 'Completed') && changedKeys().hasOnly(['status', 'updatedAt']))
          || (movesTo('Preparing', 'Cancelled') && preparingOverdue() && sellerCancelFields())
        );
      }

      function customerCanCancel() {
        return signedIn()
          && resource.data.userId == request.auth.uid
          && movesTo('Pending', 'Cancelled')
          && changedKeys().hasOnly(['status', 'updatedAt', 'cancelledBy'])
          && request.resource.data.get('cancelledBy', 'customer') == 'customer';
      }

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isSeller());
      allow update: if sellerCanUpdate() || customerCanCancel();
      allow delete: if false;
    }
  }
}
